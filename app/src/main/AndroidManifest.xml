<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Camera & Gallery access for Profile & Ancestor Portraits -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Audio Recording for Oral History Time Capsules -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Needed for PDF/PNG/GEDCOM/CSV export on Android < 10 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Needed for Over-The-Air (OTA) in-app APK installation prompts -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".KinTraceApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Bloodline Tracer"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.BTProject2">

        <activity
            android:name=".ui.activities.LoginActivity"
            android:exported="true" />
        <activity
            android:name=".ui.activities.RegisterActivity"
            android:exported="true" />
        <activity
            android:name=".ui.activities.VerifyEmailActivity"
            android:exported="true" />
        <activity android:name=".ui.activities.ForgotPasswordActivity" />
        <activity android:name=".ui.activities.InteractiveTreeActivity"
            android:exported="false"
            android:label="Interactive Tree" />

        <activity android:name=".ui.activities.WelcomeActivity" />

        <activity
            android:name=".ui.activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activities.HomeActivity"
            android:launchMode="singleTop"
            android:exported="true" />
        <activity android:name=".ui.activities.AddMemberActivity" />
        <activity android:name=".ui.activities.TraceActivity" />
        <activity android:name=".MainActivity" />
        <activity android:name=".ui.activities.FamilyRecordsActivity" />
        <activity android:name=".ui.activities.RelationshipTypesActivity" />
        <activity android:name=".ui.activities.MemberDetailActivity" />
        <activity android:name=".ui.activities.InsightsActivity" />
        <activity android:name=".ui.activities.RelationshipPathActivity" />
        <activity android:name=".ui.activities.MergeBranchesActivity" />
        <activity
            android:name=".ui.activities.AdminPortalActivity"
            android:exported="false"
            android:label="System Admin Citadel" />

        <!-- ── NEW ACTIVITIES ──────────────────────────────────── -->
        <activity android:name=".ui.activities.FamilyTreeActivity" />
        <activity android:name=".ui.activities.ExportTreeActivity" />
        <activity android:name=".ui.activities.PrivacyControlsActivity" />
        <activity android:name=".ui.activities.CreateTreeActivity" />
        <activity android:name=".ui.activities.JoinTreeActivity" />
        <activity android:name=".ui.activities.EditMemberActivity" />
        <activity
            android:name=".ui.activities.ReunionHostActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:label="KinClash Host Command Center" />
        <activity
            android:name=".ui.activities.ReunionPlayerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:label="KinClash Player Game" />
        <activity android:name=".ui.activities.PhotoCropperActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="Photo Cropper &amp; Studio" />
        <activity android:name=".ui.activities.NotificationsActivity" />
        <activity android:name=".ui.activities.RecentActivitiesActivity" />
        <activity android:name=".ui.activities.TreeAuditActivity"
            android:exported="false"
            android:label="Tree Audit &amp; Legal Verification" />
        <activity android:name=".ui.activities.RelationshipReportActivity"
            android:exported="false"
            android:label="Relationship Report" />
        <activity android:name=".ui.activities.KinAcademyActivity"
            android:exported="true"
            android:label="KinAcademy" />

        <!-- FileProvider for secure PDF export and sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Milestone Alarm Receiver for morning lock-screen notifications -->
        <receiver
            android:name=".receivers.MilestoneAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.example.btproject2.ACTION_CHECK_MILESTONES" />
            </intent-filter>
        </receiver>

        <!-- KinClash Test Receiver for automated party game orchestration -->
        <receiver
            android:name=".receivers.KinClashTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.btproject2.START_KINCLASH" />
                <action android:name="com.example.btproject2.NEXT_QUESTION" />
                <action android:name="com.example.btproject2.FINISH_GAME" />
                <action android:name="com.example.btproject2.APPROVE_CLAIM" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
