<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/viewGenDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/badge_pill_gold"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/tvGenLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GENERATION 1"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/gold_accent"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/tvGenMemberCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/dark_subtext"
        android:layout_marginStart="6dp" />

</LinearLayout>
