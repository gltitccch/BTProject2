<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#040906">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#0A1810">

        <TextView
            android:id="@+id/btnCropCancelTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#8FA899"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvCropTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Frame &amp; Crop Photo"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCropSaveTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="#D4AF37"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Interactive Canvas Cropper Area -->
    <com.example.btproject2.views.KinTraceCropImageView
        android:id="@+id/cropImageView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#020604" />

    <!-- Bottom Controls Deck -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0B1C13"
        android:padding="16dp">

        <!-- Zoom Slider Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Zoom"
                android:textColor="#8FA899"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <SeekBar
                android:id="@+id/seekZoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="250"
                android:progress="0"
                android:thumbTint="#D4AF37"
                android:progressTint="#D4AF37" />

            <TextView
                android:id="@+id/tvZoomValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="1.0x"
                android:textColor="#D4AF37"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnCropRotate"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🔄 Rotate 90°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#153624"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnCropReset"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🎯 Center"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#153624"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Large Save Button -->
        <Button
            android:id="@+id/btnCropApply"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Apply Profile Picture"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#D4AF37" />
    </LinearLayout>

</LinearLayout>
