<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardQuestHud"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="@color/border"
    app:cardBackgroundColor="@color/card_bg"
    tools:theme="@style/Theme.BTProject2"
    tools:context=".ui.activities.HomeActivity"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱"
                    android:textSize="20sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvQuestTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clan Builder Quest"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <!-- Percentage Pill -->
                <TextView
                    android:id="@+id/tvQuestPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="@color/primary_light"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Collapse / Expand Toggle Button -->
            <TextView
                android:id="@+id/btnToggleQuestCollapse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="▼ Hide"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressQuestBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/border"
            android:layout_marginBottom="12dp" />

        <!-- Expandable Quest Body -->
        <LinearLayout
            android:id="@+id/layoutQuestBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginBottom="12dp" />

            <!-- Milestone 1: Roots -->
            <RelativeLayout
                android:id="@+id/rowMilestoneRoots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvMilestone1Check"
                    android:layout_width="22dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="○"
                    android:textSize="16sp"
                    android:textColor="@color/text_hint" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/tvMilestone1Check"
                    android:layout_toStartOf="@id/btnQuestRootsAction"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/tvMilestone1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Establish Family Roots"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvMilestone1Desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create or join your family tree."
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnQuestRootsAction"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Create ➔"
                    android:textSize="11sp"
                    android:textColor="@color/primary"
                    android:padding="0dp" />
            </RelativeLayout>

            <!-- Milestone 2: 2 Relatives -->
            <RelativeLayout
                android:id="@+id/rowMilestoneTwoMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvMilestone2Check"
                    android:layout_width="22dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="○"
                    android:textSize="16sp"
                    android:textColor="@color/text_hint" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/tvMilestone2Check"
                    android:layout_toStartOf="@id/btnQuestAddMember"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/tvMilestone2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Add 2 Immediate Relatives (0/2)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvMilestone2Desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connect parents, children, or spouse."
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnQuestAddMember"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="+ Add ➔"
                    android:textSize="11sp"
                    android:textColor="@color/primary"
                    android:padding="0dp" />
            </RelativeLayout>

            <!-- Milestone 3: Canvas -->
            <RelativeLayout
                android:id="@+id/rowMilestoneCanvas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvMilestone3Check"
                    android:layout_width="22dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="○"
                    android:textSize="16sp"
                    android:textColor="@color/text_hint" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/tvMilestone3Check"
                    android:layout_toStartOf="@id/btnQuestOpenCanvas"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/tvMilestone3Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Inspect Tree Canvas"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvMilestone3Desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View generated bloodline vectors."
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnQuestOpenCanvas"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Canvas ➔"
                    android:textSize="11sp"
                    android:textColor="@color/primary"
                    android:padding="0dp" />
            </RelativeLayout>

            <!-- Milestone 4: Share Code -->
            <RelativeLayout
                android:id="@+id/rowMilestoneCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvMilestone4Check"
                    android:layout_width="22dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="○"
                    android:textSize="16sp"
                    android:textColor="@color/text_hint" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/tvMilestone4Check"
                    android:layout_toStartOf="@id/btnQuestShareCode"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/tvMilestone4Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Share Clan Invite Code"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvMilestone4Desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Invite relatives with your 6-char code."
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnQuestShareCode"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Code ➔"
                    android:textSize="11sp"
                    android:textColor="@color/primary"
                    android:padding="0dp" />
            </RelativeLayout>

        </LinearLayout>

        <!-- Celebration State Container (Visible when 100%) -->
        <LinearLayout
            android:id="@+id/layoutQuestCelebration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉 Clan Foundations Established!"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your tree is active with living relationships. You're ready to explore!"
                android:textSize="11.5sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnDismissQuest"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Dismiss Checklist"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
