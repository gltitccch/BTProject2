<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_forest_card">

    <TextView
        android:id="@+id/tvQuickAddHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Second Biological Parent"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter the details of the other biological parent to link them to the tree and the new child."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="First Name *"
        android:textColor="@color/mint_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etQuickFirstName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_dark"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:hint="e.g. Maria"
        android:inputType="textPersonName"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Last Name *"
        android:textColor="@color/mint_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etQuickLastName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_dark"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:hint="e.g. Santos"
        android:inputType="textPersonName"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gender *"
        android:textColor="@color/mint_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerQuickGender"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_dark"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Birth Date (Optional)"
        android:textColor="@color/mint_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etQuickBirthDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_dark"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:hint="Select date"
        android:focusable="false"
        android:clickable="true"
        android:layout_marginBottom="8dp" />

</LinearLayout>

