<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/forest_bg">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="44dp"
        android:paddingBottom="16dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/dashboard_header_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/avatar_circle_dark"
                android:gravity="center"
                android:text="←"
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="14dp"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Merged Clan Space"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Multi-family clan unions &amp; cross-tree synergies"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMergeRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ Owner"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/gold_accent"
                android:background="@drawable/badge_pill_dark"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sandbox Isolation Assurance Pill -->
    <LinearLayout
        android:id="@+id/layoutSandboxPill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1B3326"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ Sandbox Isolated: "
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#4ECCA3" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Viewing or synthesizing trees here never alters your personal family tree in View Tree."
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Viewer Read-Only Banner -->
    <LinearLayout
        android:id="@+id/layoutViewerBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#261E05"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👁 Viewer Mode: Clan tree synthesis is restricted to Owners."
            android:textSize="11sp"
            android:textColor="@color/gold_accent" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Zero-Risk Clan Tree Synthesis Hero Card -->
            <LinearLayout
                android:id="@+id/cardSynthesizeClanHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero_card"
                android:padding="18dp"
                android:layout_marginBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ZERO-RISK CLAN FUSION"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/gold_accent"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROPOSAL 15 &amp; 16"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/badge_pill_dark"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Synthesize Master Clan Tree"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Combine two separate family trees (e.g., Paternal &amp; Maternal, or a Spouse's tree via 6-digit Invite Code) into a new Master Clan Tree C. Both original trees remain 100% untouched and safe."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnOpenSynthesizeClanTree"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="➕  Synthesize New Clan Tree"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0A1B12"
                    android:background="@drawable/btn_gold_primary"
                    app:backgroundTint="@null"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- Independent Clan Merge Invite Code Card -->
            <LinearLayout
                android:id="@+id/cardMyMergeCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero_card"
                android:padding="16dp"
                android:layout_marginBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="YOUR TREE CLAN MERGE CODE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/gold_accent"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INDEPENDENT"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#4ECCA3"
                        android:background="@drawable/badge_pill_dark"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share this unique merge code with family members or in-laws so they can synthesize a combined Master Clan Tree with your tree. Your original family tree remains strictly read-only and preserved."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="12dp" />

                <!-- Code display & Copy row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvMyMergeCodeDisplay"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/badge_pill_dark"
                        android:gravity="center"
                        android:text="------"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/gold_accent"
                        android:letterSpacing="0.2"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnCopyMyMergeCode"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:text="📋 Copy"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0A1B12"
                        android:background="@drawable/btn_gold_primary"
                        app:backgroundTint="@null"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnRegenerateMyMergeCode"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:text="🔄"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/badge_pill_dark"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- Synthesized Clan Trees Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SYNTHESIZED CLAN TREES (SANDBOX)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/gold_accent"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvClanTreeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scanning..."
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Loading Spinner -->
            <ProgressBar
                android:id="@+id/progressBarMerge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:indeterminateTint="@color/gold_accent" />

            <!-- Empty State for Clan Trees -->
            <LinearLayout
                android:id="@+id/layoutEmptyClanState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_forest_card"
                android:padding="28dp"
                android:visibility="gone"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/badge_pill_dark"
                    android:gravity="center"
                    android:text="🏛️"
                    android:textSize="22sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Synthesized Clan Trees Yet"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your primary family tree in View Tree is preserved and clean. Tap 'Synthesize New Clan Tree' above to combine two family trees into a dedicated clan sandbox."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Container for Clan Trees -->
            <LinearLayout
                android:id="@+id/clanTreesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp" />

            <!-- Secondary Section: Single-Tree Intra-Branch Connector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_forest_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INTRA-TREE BRANCH CONNECTIONS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/gold_accent"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Link Disconnected Nodes Inside Current Tree"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect floating or unparented nodes within your currently active family tree."
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnOpenConnectBranches"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="🔗  Connect Internal Tree Nodes"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/badge_pill_dark"
                    android:textAllCaps="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>