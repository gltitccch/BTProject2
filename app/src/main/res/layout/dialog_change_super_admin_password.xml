<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_forest_card"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔑 Master Admin Password"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set a new master password for your Root Sovereign admin account."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etNewMasterPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="14dp"
        android:textSize="13.5sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:hint="At least 8 chars with symbols"
        android:inputType="textPassword"
        android:layout_marginBottom="10dp" />

    <!-- Direction 1: Dynamic Shield Meter + Live Criteria Badges -->
    <include
        android:id="@+id/layoutMasterPasswordStrength"
        layout="@layout/layout_password_strength_meter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etConfirmMasterPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="14dp"
        android:textSize="13.5sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:hint="Confirm Master Password"
        android:inputType="textPassword"
        android:layout_marginBottom="8dp" />

    <!-- Live Password Match Indicator -->
    <TextView
        android:id="@+id/tvMasterPasswordMatchPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="✓ Passwords Match" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelChangePassword"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cancel"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSubmitChangePassword"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Update Password ✓"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="@color/btn_gold_text"
            android:background="@drawable/btn_gold_primary"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
