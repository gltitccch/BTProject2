<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header Area (Harmonious Canvas, No harsh split-boxes or gold side arcs) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="38dp"
            android:paddingBottom="10dp">

            <!-- Brand Wordmark -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KINTRACE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.16"
                android:textColor="@color/gold_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Family Tree &amp; Lineage"
                android:textSize="10.5sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.04"
                android:layout_marginTop="2dp" />

            <!-- Welcome Back Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to explore your family bloodline."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Keystone + Floating Card Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="14dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Floating Elevated Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_login_card"
                android:elevation="4dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="36dp"
                android:paddingBottom="22dp">

                <!-- Card Subtitle Row (Left: ACCOUNT, Right: Sign-In) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ACCOUNT"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/gold_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign-In"
                        android:textSize="11sp"
                        android:textColor="@color/text_hint" />
                </LinearLayout>

                <!-- Email Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp" />

                <!-- Email Input Field with leading icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_login_input_field"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✉️"
                        android:textSize="15sp"
                        android:alpha="0.7"
                        android:layout_marginEnd="10dp" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Enter your email"
                        android:inputType="textEmailAddress"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </LinearLayout>

                <!-- Password Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp" />

                <!-- Password Input Field with leading icon & toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_login_input_field"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="15sp"
                        android:alpha="0.7"
                        android:layout_marginEnd="10dp" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Enter your password"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />

                    <ImageView
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="11dp"
                        android:src="@drawable/ic_visibility_off"
                        android:contentDescription="Show password"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Forgot Password -->
                <TextView
                    android:id="@+id/btnForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot Password?"
                    android:textSize="12sp"
                    android:textColor="@color/gold_accent"
                    android:textStyle="bold"
                    android:layout_gravity="end"
                    android:layout_marginBottom="22dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Login Button -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Sign In to KinTrace ➔"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_gold_text"
                    android:background="@drawable/btn_primary_bg"
                    android:textAllCaps="false"
                    android:layout_marginBottom="16dp" />

                <!-- Register link inside card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New here? "
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/btnRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create Account"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/gold_accent"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

            </LinearLayout>

            <!-- Integrated Medallion Keystone (Locks atop card center) -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_keystone_medallion"
                android:elevation="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_kintrace_tree_gold"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
            </FrameLayout>

        </FrameLayout>

        <!-- Spacer to push quote toward bottom cleanly -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="28dp" />

        <!-- Bottom Quote Section (Without 'Archive') -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp"
            android:paddingTop="12dp">

            <View
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/gold_accent"
                android:alpha="0.4"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="“A family tree can wither if nobody tends to the stories of its roots.”"
                android:textSize="12sp"
                android:textStyle="italic"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— KinTrace Lineage"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_hint" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>