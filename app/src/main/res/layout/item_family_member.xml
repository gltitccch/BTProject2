<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_forest_card"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="10dp">

    <!-- Avatar Circle -->
    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="JD"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/gold_accent"
        android:background="@drawable/avatar_circle_dark"
        android:layout_marginEnd="12dp" />

    <!-- Name and Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Juan dela Cruz"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvMemberInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Male · Gen. 1"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnAddChild"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Child"
            android:textSize="12sp"
            android:textColor="@color/emerald_accent"
            android:textStyle="bold"
            android:background="@drawable/pill_btn_emerald"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:textSize="13sp"
            android:textColor="@color/gold_accent"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textSize="13sp"
            android:textColor="@color/danger"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>