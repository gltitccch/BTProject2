<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardDemoItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_demo_card"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar Medallion with Emoji -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_demo_medallion">

        <TextView
            android:id="@+id/tvDemoEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="👑"
            android:textSize="18sp" />
    </FrameLayout>

    <!-- Persona Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp">

        <!-- Name + Role Pill Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDemoName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Augustine Russell"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvDemoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PATRIARCH"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="@color/gold_accent"
                android:background="@drawable/bg_demo_role_badge"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1.5dp"
                android:paddingBottom="1.5dp"
                android:layout_marginStart="5dp"
                android:singleLine="true"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Tree Summary Stats -->
        <TextView
            android:id="@+id/tvDemoSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20 Members • 4 Generations • 44 Records"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- 1-Tap Action Pill -->
    <TextView
        android:id="@+id/tvDemoAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1-Tap ➔"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:textColor="@color/gold_accent" />

</LinearLayout>
