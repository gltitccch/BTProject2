<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_action_restricted_dialog"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Shield Padlock Crest (Figure 16) -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:gravity="center"
        android:background="@drawable/circle_dark_action"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- Role Restriction Pill -->
    <TextView
        android:id="@+id/tvRestrictedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VIEWER RESTRICTION"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:textColor="@color/gold_accent"
        android:letterSpacing="0.08"
        android:background="@drawable/badge_pill_dark"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginBottom="6dp" />

    <!-- Title (Figure 16: Action restricted) -->
    <TextView
        android:id="@+id/tvRestrictedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Action restricted"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <!-- Explanation Message -->
    <TextView
        android:id="@+id/tvRestrictedMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You do not have permission to edit this record. Only the tree owner or authorized editors can modify family member information."
        android:textSize="12sp"
        android:textColor="@color/dark_subtext"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="22dp" />

    <!-- Positive Action: Request Access (Figure 16) -->
    <TextView
        android:id="@+id/btnRequestAccess"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/btn_gold_primary"
        android:text="Request Access"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#0A1B12"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="10dp" />

    <!-- Dismiss: Okay (Figure 16) -->
    <TextView
        android:id="@+id/btnDismissRestricted"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_dark_secondary"
        android:text="Okay"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
