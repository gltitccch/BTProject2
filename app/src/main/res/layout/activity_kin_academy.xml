<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/forest_bg"
    android:fitsSystemWindows="true">

    <!-- Top Header Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="14dp"
        android:background="@color/forest_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_back_pill"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="← Back"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAcademyHeaderBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎓 10 MODULES"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/gold_accent"
                android:background="@drawable/badge_pill_dark"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KinAcademy"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Genealogical Knowledge Hub, System Guide &amp; Lexicon"
            android:textSize="12.5sp"
            android:textColor="@color/dark_subtext"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Search Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_quick_assist_card"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="16sp"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etSearchAcademy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Search lessons, terms, laws (e.g. MRCA, RA 11596)..."
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/dark_subtext"
            android:background="@null"
            android:inputType="text"
            android:imeOptions="actionSearch" />

        <TextView
            android:id="@+id/btnClearSearch"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="14sp"
            android:textColor="@color/dark_subtext"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Horizontal Category Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/chipFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Modules (10)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/forest_bg"
                android:background="@drawable/btn_gold_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFilterFoundations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foundations"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/badge_pill_dark"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFilterCanvas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Canvas &amp; Pedigree"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/badge_pill_dark"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFilterBloodline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bloodline Tracer"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/badge_pill_dark"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFilterArchival"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Archival &amp; Export"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/badge_pill_dark"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFilterLexicon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇵🇭 Kamag-anak Lexicon"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/badge_pill_dark"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Container with RecyclerViews -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Modules RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAcademyModules"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never" />

        <!-- Kamag-anak Lexicon RecyclerView (Shown when Lexicon chip is selected) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvKamagAnakGlossary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:visibility="gone" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layoutEmptyResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="36sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No lessons or terms match your search"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try searching for 'MRCA', 'Pinsan', 'RA 11596', or 'Export'"
                android:textSize="12sp"
                android:textColor="@color/dark_subtext"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
