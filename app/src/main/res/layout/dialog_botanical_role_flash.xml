<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootBotanicalFlashOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EB050C08"
    android:clickable="true"
    android:focusable="true">

    <!-- Full-screen 60fps Drifting Leaves & Wind-Borne Golden Messenger Leaf Layer -->
    <com.example.btproject2.views.BotanicalForestFxOverlayView
        android:id="@+id/botanicalForestFxView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Center Dimmed Botanical Flash Modal Card (Matches Photo 2: #0C1C13 + 1.5dp Gold Border #D4AF37) -->
    <LinearLayout
        android:id="@+id/cardBotanicalFlashModal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_botanical_flash_card"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:elevation="22dp">

        <!-- 60fps Growing Family Tree Stage (Sprout -> Branch -> Canopy + 6 Glowing Fireflies) -->
        <com.example.btproject2.views.BotanicalRoleStageView
            android:id="@+id/botanicalRoleStageView"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="6dp" />

        <!-- Botanical Role Badge Pill -->
        <TextView
            android:id="@+id/tvFlashRoleBadgePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌱 YOU'RE CURRENTLY A VIEWER (SPROUT)"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="#4ADE80"
            android:background="@drawable/bg_botanical_role_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:layout_marginBottom="8dp" />

        <!-- Feature / Ceremony Title (Georgia Serif Bold) -->
        <TextView
            android:id="@+id/tvFlashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deep Roots Privacy &amp; Access"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="#F4F7F4"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvFlashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This part of the grove requires the 🌳 Root &amp; Canopy Keeper (Owner) badge."
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="#9DB2A4"
            android:layout_marginBottom="13dp" />

        <!-- Botanical Capabilities Checklist Box (Matches Photo 2: #132B1E Surface + #1E3F2B Border) -->
        <LinearLayout
            android:id="@+id/layoutCapabilitiesBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_botanical_capabilities_box"
            android:paddingHorizontal="13dp"
            android:paddingVertical="11dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvCapabilitiesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿 WHAT YOUR 🌱 VIEWER BADGE CAN DO"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#D4AF37"
                android:letterSpacing="0.05"
                android:layout_marginBottom="7dp" />

            <!-- Row 1 -->
            <LinearLayout
                android:id="@+id/rowCap1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="3.5dp">
                <TextView
                    android:id="@+id/tvCapIcon1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱"
                    android:textSize="12.5sp"
                    android:layout_marginEnd="7dp" />
                <TextView
                    android:id="@+id/tvCapLabel1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Explore Family Tree &amp; Fan Chart"
                    android:textSize="12sp"
                    android:textColor="#F4F7F4" />
                <TextView
                    android:id="@+id/tvCapStatus1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Allowed"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#34D399" />
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:id="@+id/rowCap2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="3.5dp">
                <TextView
                    android:id="@+id/tvCapIcon2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍃"
                    android:textSize="12.5sp"
                    android:layout_marginEnd="7dp" />
                <TextView
                    android:id="@+id/tvCapLabel2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Search Relatives &amp; Biographies"
                    android:textSize="12sp"
                    android:textColor="#F4F7F4" />
                <TextView
                    android:id="@+id/tvCapStatus2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Allowed"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#34D399" />
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:id="@+id/rowCap3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="3.5dp">
                <TextView
                    android:id="@+id/tvCapIcon3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌿"
                    android:textSize="12.5sp"
                    android:layout_marginEnd="7dp" />
                <TextView
                    android:id="@+id/tvCapLabel3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Graft / Edit Family Members"
                    android:textSize="12sp"
                    android:textColor="#F4F7F4" />
                <TextView
                    android:id="@+id/tvCapStatus3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Branch Editor+"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#D4AF37" />
            </LinearLayout>

            <!-- Row 4 -->
            <LinearLayout
                android:id="@+id/rowCap4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="3.5dp">
                <TextView
                    android:id="@+id/tvCapIcon4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌳"
                    android:textSize="12.5sp"
                    android:layout_marginEnd="7dp" />
                <TextView
                    android:id="@+id/tvCapLabel4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Deep Roots Privacy &amp; Roles"
                    android:textSize="12sp"
                    android:textColor="#F4F7F4" />
                <TextView
                    android:id="@+id/tvCapStatus4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Tree Owner"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#D4AF37" />
            </LinearLayout>
        </LinearLayout>

        <!-- Upgrade Guidance Box (Matches Photo 2: Subtle Emerald Tint + Warm Gold Border + Bold Lead-in) -->
        <TextView
            android:id="@+id/tvUpgradeGuidanceHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌱 Want your role to grow? Ask the owner of this family tree to nurture &amp; upgrade your role so you can access this feature!"
            android:textSize="11.5sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="#F4F7F4"
            android:background="@drawable/bg_botanical_upgrade_hint"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="13dp" />

        <!-- Primary Action: Bright Metallic Gold Gradient (#D4AF37 -> #E6C762) with Deep Forest Text (#060D09) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFlashPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🍃 Send Golden Leaf Request to Tree Owner"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#060D09"
            android:background="@drawable/bg_botanical_gold_gradient_btn"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp" />

        <!-- Secondary Action: Return to Family Tree (1.5dp Emerald Border #1E3F2B + Crisp White Text) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFlashSecondaryDismiss"
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:text="Return to Family Tree"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F4F7F4"
            android:background="@drawable/bg_botanical_secondary_btn"
            android:textAllCaps="false" />

    </LinearLayout>

</FrameLayout>
