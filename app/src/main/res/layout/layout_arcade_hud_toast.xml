<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutArcadeToastRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_arcade_dialog"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:elevation="20dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Arcade Icon Wrap -->
    <TextView
        android:id="@+id/tvToastIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="📋"
        android:textSize="17sp"
        android:background="@drawable/bg_arcade_pill_black"
        android:layout_marginEnd="12dp" />

    <!-- Text Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvToastTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PIN Copied to Clipboard!"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_display_sora"
            android:textColor="#FFFFFF"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvToastSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share PIN with clan members"
            android:textSize="11sp"
            android:fontFamily="@font/font_mono_jetbrains"
            android:textColor="@color/arcade_yellow"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="1dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
