<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/containerFloatingNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp"
    android:paddingTop="2dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Placement 2: Floating Network Dock Pill directly above Island Nav -->
    <LinearLayout
        android:id="@+id/dockNetworkStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginBottom="8dp"
        android:elevation="16dp"
        android:visibility="gone"
        android:background="@drawable/bg_network_dock_offline">

        <TextView
            android:id="@+id/tvNetworkDockIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡"
            android:textSize="12sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvNetworkDockMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline Mode · Local Archive"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FED7AA" />

        <TextView
            android:id="@+id/btnNetworkDockRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retry 🔄"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_network_retry"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/islandNavBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_nav_floating_island"
        android:gravity="center_vertical"
        android:elevation="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- Tab 1: Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavHome"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_home_vector"
                android:contentDescription="Home Tab" />

            <TextView
                android:id="@+id/tvNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="9.5sp"
                android:textColor="@color/dark_nav_inactive"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tab 2: Tree -->
        <LinearLayout
            android:id="@+id/navTree"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavTree"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_tree_vector"
                android:contentDescription="Tree Tab" />

            <TextView
                android:id="@+id/tvNavTree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tree"
                android:textSize="9.5sp"
                android:textColor="@color/dark_nav_inactive"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Center Docked Heritage Guide Crest (Zenith Sparkle) -->
        <FrameLayout
            android:id="@+id/layoutNavGuideCrest"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">

            <LinearLayout
                android:id="@+id/btnNavGuideCrest"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="-10dp"
                android:background="@drawable/bg_nav_guide_crest"
                android:elevation="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivNavGuideCrestIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_zenith_sparkle_vector"
                    android:contentDescription="Guide Crest" />

                <TextView
                    android:id="@+id/tvNavGuideCrestLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GUIDE"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:textColor="@color/gold_accent"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Guide Crest Discovery Beacon (Direction 1) -->
            <TextView
                android:id="@+id/tvGuideCrestBeacon"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-12dp"
                android:layout_marginEnd="-2dp"
                android:background="@drawable/badge_pill_gold"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="TIP"
                android:textColor="@color/btn_gold_text"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Tab 3: Trace -->
        <LinearLayout
            android:id="@+id/navTrace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavTrace"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_trace_vector"
                android:contentDescription="Trace Tab" />

            <TextView
                android:id="@+id/tvNavTrace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trace"
                android:textSize="9.5sp"
                android:textColor="@color/dark_nav_inactive"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tab 4: Profile -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavProfile"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_profile_vector"
                android:contentDescription="Profile Tab" />

            <TextView
                android:id="@+id/tvNavProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="9.5sp"
                android:textColor="@color/dark_nav_inactive"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
