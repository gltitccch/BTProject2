<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="48dp">

        <!-- Back Button -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- STATE 1: JOIN FORM -->
        <LinearLayout
            android:id="@+id/layoutJoinForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="visible">

            <!-- Icon -->
            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:text="👥"
                android:textSize="28sp"
                android:background="@drawable/profile_circle_bg"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join a family tree"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter the invite code shared by a family tree owner to request access."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="28dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Invite code"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etInviteCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="e.g. DC2488"
                android:inputType="textCapCharacters"
                android:maxLength="12"
                android:gravity="center"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:textColor="@color/primary"
                android:background="@drawable/input_bg_white"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ask the tree owner for a 6-character invite code."
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/btnRequestAccess"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Join Tree"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0A1B12"
                android:background="@drawable/btn_primary_bg"
                android:textAllCaps="false"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The tree owner will review and approve your request."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:gravity="center" />
        </LinearLayout>

        <!-- STATE 2: PENDING APPROVAL SCREEN (Figure 5 Screen 04) -->
        <LinearLayout
            android:id="@+id/layoutPendingApproval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <!-- Clock icon -->
            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:text="⏳"
                android:textSize="32sp"
                android:background="@drawable/profile_circle_bg"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Request sent"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvPendingTreeMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your request to join the family tree has been sent. The tree owner will review and approve your access."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳  Pending approval"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/warning"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You'll be notified once the owner approves your request."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPendingBackToHome"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Back to home"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/btn_outline_bg"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

