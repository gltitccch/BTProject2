<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_quick_assist_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/badge_pill_dark" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="@drawable/bg_quick_assist_card"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_book_minimal"
                android:contentDescription="Guide Icon" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvQuickAssistTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QuickAssist Help"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvQuickAssistSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screen Guidance &amp; Tips"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Close Button -->
        <TextView
            android:id="@+id/btnQuickAssistClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_quick_assist_card"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Prominent Spotlight Tour Launch Button (Top-Positioned for Instant Discovery) -->
    <TextView
        android:id="@+id/btnReplaySpotlightTour"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="✨  Start Interactive Visual Tour ↻"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/gold_accent"
        android:background="@drawable/bg_tool_dock_tag"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp" />

    <!-- Scrollable Body for Numbered Tip Cards and Left-Border Legal Bar -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Pro Tips Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KEY FEATURES &amp; SHORTCUTS"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/gold_accent"
                android:layout_marginBottom="8dp" />

            <!-- Dynamic Numbered Pro Tips Container (UI 1) -->
            <LinearLayout
                android:id="@+id/layoutProTipsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <!-- Legal Guardrails Section (UI 1 Left-Border Accent Bar) -->
            <LinearLayout
                android:id="@+id/layoutLegalContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_quick_assist_legal_bar"
                android:paddingStart="15dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHILIPPINE LEGAL &amp; DATA GUARDRAIL"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/gold_accent"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvLegalGuardrailsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Restore Guide Crest in Navigation Bar (Shown when Guide Crest was dismissed) -->
    <TextView
        android:id="@+id/btnRestoreGuideCrest"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="🛡️  Restore Guide Crest to Navigation Bar ✨"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="@color/gold_accent"
        android:background="@drawable/bg_tool_dock_tag"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

    <!-- Deep Link to KinAcademy Masterclass -->
    <TextView
        android:id="@+id/btnOpenFullAcademy"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="Open Full KinAcademy Masterclass →"
        android:textSize="13.5sp"
        android:textStyle="bold"
        android:textColor="@color/btn_gold_text"
        android:background="@drawable/btn_gold_primary"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="4dp" />

</LinearLayout>
