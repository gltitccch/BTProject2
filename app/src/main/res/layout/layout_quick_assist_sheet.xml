<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_quick_assist_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/badge_pill_dark" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/circle_dark_action"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvQuickAssistTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QuickAssist Help"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvQuickAssistSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screen Guidance &amp; Tips"
                android:textSize="12sp"
                android:textColor="@color/dark_subtext"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Close Button -->
        <TextView
            android:id="@+id/btnQuickAssistClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dark_subtext"
            android:background="@drawable/circle_dark_action"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Scrollable Body for Tips and Legal Notes -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Pro Tips Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRO TIPS &amp; SHORTCUTS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/gold_accent"
                android:layout_marginBottom="8dp" />

            <!-- Dynamic Pro Tips Container -->
            <LinearLayout
                android:id="@+id/layoutProTipsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_quick_assist_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="14dp" />

            <!-- Legal Guardrails Section (Conditionally Visible) -->
            <LinearLayout
                android:id="@+id/layoutLegalContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_quick_assist_guardrail"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚖️ LEGAL &amp; DATA GUARDRAILS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/gold_accent"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvLegalGuardrailsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Deep Link to KinAcademy Masterclass -->
    <TextView
        android:id="@+id/btnOpenFullAcademy"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Open Full KinAcademy Masterclass →"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/forest_bg"
        android:background="@drawable/btn_gold_primary"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="8dp" />

</LinearLayout>
