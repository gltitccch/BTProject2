<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutPasswordStrengthRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_password_strength_card"
    android:padding="14dp">

    <!-- Header Meta Row: Label + Score -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvStrengthTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Security Strength:"
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvStrengthScoreLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Very Weak"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#EF4444"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- 4-Segment Progress Bar -->
    <LinearLayout
        android:id="@+id/layoutMeterSegments"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <View
            android:id="@+id/viewMeterSeg1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_meter_segment" />

        <View
            android:id="@+id/viewMeterSeg2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_meter_segment" />

        <View
            android:id="@+id/viewMeterSeg3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_meter_segment" />

        <View
            android:id="@+id/viewMeterSeg4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_meter_segment" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14281C"
        android:layout_marginBottom="10dp" />

    <!-- 2x2 Criteria Badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <!-- 8+ Characters -->
        <LinearLayout
            android:id="@+id/layoutCriterionLength"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_criterion_badge_default"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvCritIconLength"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="✕"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:background="@drawable/bg_criterion_icon_default"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvCritTextLength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8+ Characters"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 1 Uppercase -->
        <LinearLayout
            android:id="@+id/layoutCriterionUpper"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_criterion_badge_default"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvCritIconUpper"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="✕"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:background="@drawable/bg_criterion_icon_default"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvCritTextUpper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 Uppercase (A-Z)"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 1 Number -->
        <LinearLayout
            android:id="@+id/layoutCriterionNumber"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_criterion_badge_default"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvCritIconNumber"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="✕"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:background="@drawable/bg_criterion_icon_default"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvCritTextNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 Number (0-9)"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 1 Symbol -->
        <LinearLayout
            android:id="@+id/layoutCriterionSymbol"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_criterion_badge_default"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvCritIconSymbol"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="✕"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:background="@drawable/bg_criterion_icon_default"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvCritTextSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 Symbol (!@#$%)"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
