<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/item_member_dark_bg"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Document Type Icon Badge -->
    <TextView
        android:id="@+id/tvDocIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="📄"
        android:textSize="20sp"
        android:background="@drawable/icon_squircle_dark"
        android:layout_marginEnd="12dp" />

    <!-- Document Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDocName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Birth_Certificate.pdf"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:ellipsize="middle"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvDocCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Birth Certificate"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/mint_text"
                android:background="@drawable/badge_pill_dark"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvDocMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="145 KB · Sep 23, 2026"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <TextView
        android:id="@+id/btnViewDoc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/gold_accent"
        android:background="@drawable/badge_pill_dark"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginStart="8dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnDeleteDoc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✕"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/danger"
        android:background="@drawable/badge_pill_dark"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginStart="6dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>

