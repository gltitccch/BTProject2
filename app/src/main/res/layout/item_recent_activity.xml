<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/item_member_dark_bg"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvRecentIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="JD"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_display_sora"
        android:textColor="@color/gold_accent_light"
        android:background="@drawable/avatar_circle_dark"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Juan Dela Cruz"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_display_sora"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tvRecentSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grandfather · Paternal"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/dark_subtext" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tvRecentGenBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G3"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_display_sora"
            android:textColor="@color/gold_accent_light"
            android:background="@drawable/bg_tool_dock_tag"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvRecentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2h ago"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="@color/dark_subtext" />
    </LinearLayout>

</LinearLayout>
