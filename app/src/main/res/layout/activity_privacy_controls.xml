<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Green Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/forest_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="20dp">

        <!-- Header Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_back_pill"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="← Back"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnQuickAssistPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/ic_help_minimal"
                android:drawablePadding="5dp"
                android:text="Help"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_nav_back_pill"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy &amp; access"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage tree permissions and member visibility."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- STATE 1: OWNER VIEW (Figure 14, Screen 03) -->
    <ScrollView
        android:id="@+id/layoutOwnerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ZERO-KNOWLEDGE CLOUD PROTECTION (AES-256-GCM + JWT RS256) -->
            <LinearLayout
                android:id="@+id/cardZeroKnowledgeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="🛡️"
                        android:textSize="18sp"
                        android:background="@drawable/bg_criterion_badge_met" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zero-Knowledge Cloud Protection"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sensitive family fields (birthplace, passing place &amp; biography) are automatically encrypted with AES-256-GCM before leaving your phone."
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tvAesStatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 AES-256-GCM Active"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#2EBD6B"
                        android:background="@drawable/bg_criterion_badge_met"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />

                    <TextView
                        android:id="@+id/tvJwtStatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎟️ JWT RS256 Verified"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:background="@drawable/bg_criterion_badge_default"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TREE VISIBILITY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tree visibility"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Private tree"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Only you and authorized members can access this tree."
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchPrivateTree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- AUTHORIZED MEMBERS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvAuthorizedTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Authorized members"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/btnInviteMember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Invite"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAuthorizedMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp" />

            <!-- ISOLATED PENDING REQUESTS ENTRY TILE (Zero Flooding) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPendingRequestsTile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/gold_accent"
                app:cardBackgroundColor="@color/forest_card">

                <LinearLayout
                    android:id="@+id/btnOpenPendingRequestsSheet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:text="🍃"
                        android:textSize="18sp"
                        android:background="@drawable/badge_pill_dark"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPendingRequestsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending Role Requests"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#F4F7F4" />

                        <TextView
                            android:id="@+id/tvPendingRequestsSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to review and grant Editor keys"
                            android:textSize="11.5sp"
                            android:textColor="#A0B2A6"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPendingCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Pending"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#060D09"
                        android:background="@drawable/badge_pill_gold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#D4AF37" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hidden legacy container retained for zero crash risk -->
            <LinearLayout
                android:id="@+id/layoutPendingRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPendingRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- HIDDEN INFORMATION (REDACTION) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hidden information"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hidden from non-owner viewers"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="10dp" />

            <!-- Hide Birth Dates -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hide birth dates"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <Switch
                    android:id="@+id/switchHideBirthDates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Hide Notes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hide notes"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <Switch
                    android:id="@+id/switchHideNotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Hide Deceased Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="14dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hide deceased status"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <Switch
                    android:id="@+id/switchHideDeceasedStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSavePrivacy"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Save Privacy Settings"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_primary_bg"
                android:textAllCaps="false"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- STATE 2: RESTRICTED / OWNER-ONLY BOTANICAL GATE (Figure 14, Screen 04) -->
    <LinearLayout
        android:id="@+id/layoutOwnerGate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_botanical_flash_card"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <!-- 60fps Growing Family Tree Stage (Sprout -> Branch -> Canopy) -->
        <com.example.btproject2.views.BotanicalRoleStageView
            android:id="@+id/gateBotanicalStageView"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="6dp" />

        <!-- Botanical Role Badge Pill -->
        <TextView
            android:id="@+id/tvGateRoleBadgePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌱 YOU'RE CURRENTLY A VIEWER (SPROUT)"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="#4ADE80"
            android:background="@drawable/bg_botanical_role_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deep Roots Privacy &amp; Access"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="#F4F7F4"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvGateSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This part of the grove requires the 🌳 Root &amp; Canopy Keeper (Owner) badge."
            android:textSize="12sp"
            android:textColor="#9DB2A4"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="13dp" />

        <!-- Botanical Capabilities Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_botanical_capabilities_box"
            android:paddingHorizontal="13dp"
            android:paddingVertical="11dp"
            android:layout_marginBottom="13dp">

            <TextView
                android:id="@+id/tvGateCapHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿 WHAT YOUR 🌱 VIEWER BADGE CAN DO"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#D4AF37"
                android:letterSpacing="0.05"
                android:layout_marginBottom="7dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="3.5dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌱 Explore Family Tree &amp; Fan Chart"
                    android:textSize="12sp"
                    android:textColor="#F4F7F4" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Allowed"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#34D399" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="3.5dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🍃 Search Relatives &amp; Biographies"
                    android:textSize="12sp"
                    android:textColor="#F4F7F4" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Allowed"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#34D399" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="3.5dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌿 Graft / Edit Family Members"
                    android:textSize="12sp"
                    android:textColor="#F4F7F4" />
                <TextView
                    android:id="@+id/tvGateCapEditStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Branch Editor+"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#D4AF37" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="3.5dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌳 Deep Roots Privacy &amp; Roles"
                    android:textSize="12sp"
                    android:textColor="#F4F7F4" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Tree Owner"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#D4AF37" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary Action: Send Golden Leaf Upgrade Request -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGateSendLeafRequest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🍃 Send Golden Leaf Request to Tree Owner"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#060D09"
            android:background="@drawable/bg_botanical_gold_gradient_btn"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp" />

        <!-- Secondary Action: High-Contrast Return to Family Tree Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGateBackToHome"
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:text="Return to Family Tree"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F4F7F4"
            android:background="@drawable/bg_botanical_secondary_btn"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
