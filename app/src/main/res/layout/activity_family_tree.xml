<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/forest_bg"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/forest_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="16dp">

        <!-- Tier 1: Navigation & Action Shortcuts (UI 1 Floating Tools Dropdown) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_back_pill"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="← Back"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Preserved IDs routed through Tools ▾ Popover -->
            <TextView
                android:id="@+id/btnExportTree"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnTreeLegend"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- UI 1 Floating Popover Dropdown Pill -->
            <TextView
                android:id="@+id/btnTreeToolsMenu"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/ic_tools_minimal"
                android:drawablePadding="5dp"
                android:text="Tools ▾"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_nav_back_pill"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnQuickAssistTree"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/ic_help_minimal"
                android:drawablePadding="5dp"
                android:text="Help"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_nav_back_pill"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Tier 2: Title & Combined Identity Metadata Badge (UI 3) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Family Tree"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/badge_pill_dark"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/tvTreeRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ Owner"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/gold_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_subtext" />

                <TextView
                    android:id="@+id/tvMemberCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 members"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/mint_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Viewer Read-Only Banner -->
    <LinearLayout
        android:id="@+id/layoutViewerBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/forest_card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒  "
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Browse only • no editing"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/mint_text" />
    </LinearLayout>

    <!-- Suggestion 1: Unified Recessed Segmented Track -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_segmented_track"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        android:padding="4dp">

        <TextView
            android:id="@+id/btnPedigree"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableStart="@drawable/ic_pedigree_minimal"
            android:drawablePadding="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Pedigree"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_segmented_item_active"
            android:textColor="@color/btn_gold_text"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnFanChart"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableStart="@drawable/ic_fanchart_minimal"
            android:drawablePadding="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Fan Chart"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnInteractiveTree"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableStart="@drawable/ic_interactive_minimal"
            android:drawablePadding="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Interactive"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Content Viewport (Pedigree or Fan Chart) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Pedigree RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTree"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="4dp"
            android:paddingBottom="84dp"
            android:clipToPadding="false" />

        <!-- Fan Chart WebView (hidden by default) -->
        <WebView
            android:id="@+id/webViewFan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ── Floating Heritage Island Bottom Navigation ── -->
    <include layout="@layout/layout_floating_nav_island" />

</LinearLayout>
