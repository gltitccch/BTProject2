<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hero_card"
    android:padding="16dp"
    android:layout_marginBottom="14dp">

    <!-- Top Row: Icon, Title & Member Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/avatar_circle_dark"
            android:gravity="center"
            android:text="🏛️"
            android:textSize="18sp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClanTreeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dela Cruz - Santos Master Clan Tree"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvClanTreeMemberCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="27 Members • Master Clan Sandbox"
                android:textSize="11sp"
                android:textColor="@color/gold_accent"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bridge Info -->
    <TextView
        android:id="@+id/tvClanTreeBridge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💍 Bridge: Juan Dela Cruz married to Maria Santos"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/badge_pill_dark"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="12dp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnViewClanCanvas"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="👁️  View Clan Canvas"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#0A1B12"
            android:background="@drawable/btn_gold_primary"
            app:backgroundTint="@null"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDeleteClanTree"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="🗑️ Delete"
            android:textSize="12sp"
            android:textColor="#FF6B6B"
            android:background="@drawable/badge_pill_dark"
            app:backgroundTint="@null"
            android:textAllCaps="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>
</LinearLayout>
