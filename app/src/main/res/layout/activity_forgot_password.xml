<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:paddingTop="60dp">

        <!-- Back Button -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset password"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot your password? Enter the email linked to your account. We'll send a reset link."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="36dp" />

        <!-- Email Input Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email address"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:background="@drawable/input_bg_white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:layout_marginBottom="24dp" />

        <!-- Send Reset Link Button -->
        <Button
            android:id="@+id/btnSendReset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Send reset link"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:background="@drawable/btn_primary_bg"
            android:textAllCaps="false"
            android:layout_marginBottom="24dp" />

        <!-- Success Confirmation Card (Figure 3) -->
        <LinearLayout
            android:id="@+id/cardSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Reset link sent!"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSuccessMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A password recovery link has been dispatched to your email."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="14dp" />

            <!-- Spam / Junk Warning Notice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/badge_pill_dark"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Check your Spam / Junk folder"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/gold_accent"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automated recovery emails from Firebase may be filtered as Spam or Junk. If found in Junk, please tap 'Report not spam' so future emails arrive normally."
                    android:textSize="11.5sp"
                    android:textColor="@color/dark_subtext"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Quick Open Mail Client Button -->
            <Button
                android:id="@+id/btnOpenEmailApp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="✉️  Open Email App"
                android:textSize="13.5sp"
                android:textColor="@color/white"
                android:background="@drawable/btn_primary_bg"
                android:textAllCaps="false"
                android:layout_marginBottom="12dp" />

            <!-- Resend Link & Cooldown -->
            <TextView
                android:id="@+id/btnResend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Didn't receive it? Resend link"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvResendCooldown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11.5sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

