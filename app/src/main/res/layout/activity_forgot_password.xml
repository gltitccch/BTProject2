<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Full-Screen Botanical & Wooden Branch Canopy Backdrop with Cute Hanging Family Node Charms -->
    <com.example.btproject2.ui.views.LoginBotanicalBackdropView
        android:id="@+id/resetBotanicalBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="18dp">

            <!-- Top Back Navigation Pill Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="38dp">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_nav_back_pill"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:text="← Back to Login"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display_sora"
                    android:textColor="@color/gold_accent"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Top Flexible Spacer to vertically center the Botanical Header + Card -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.45"
                android:minHeight="4dp" />

            <!-- Top Header Area: Exact Branch-Wrapped Georgia Bold "KinTrace" + Reset Password -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="4dp">

                <com.example.btproject2.ui.views.KinTraceWrappedHeaderView
                    android:id="@+id/kinTraceWrappedHeaderReset"
                    android:layout_width="308dp"
                    android:layout_height="104dp" />

                <!-- Reset Password Title (Sora Bold matching Sign In button) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset Password"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display_sora"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter the email linked to your family account and we’ll send a recovery link."
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/login_sub_text"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Keystone + Floating Recovery Card Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Floating Elevated Card (Direction 2 Recessed Emerald & Gold Bar) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_login_card"
                    android:elevation="4dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="32dp"
                    android:paddingBottom="18dp">

                    <!-- Card Eyebrow Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ACCOUNT RECOVERY"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_display_sora"
                            android:letterSpacing="0.08"
                            android:textColor="@color/gold_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Password Reset"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_login_eyebrow_pill"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:textColor="@color/login_sub_text" />
                    </LinearLayout>

                    <!-- Email Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Address"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_display_sora"
                        android:textColor="@color/login_label_text"
                        android:layout_marginBottom="6dp" />

                    <!-- Email Input Field with Direction 2 Gold Left-Accent Bar & Leading Icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_login_input_field"
                        android:paddingStart="15dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✉️"
                            android:textSize="15sp"
                            android:alpha="0.95"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Enter your registered email"
                            android:inputType="textEmailAddress"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/login_hint_text" />
                    </LinearLayout>

                    <!-- Send Reset Link Button (Exact Sora Bold Font & Dark-on-Gold Text matching Sign In to KinTrace) -->
                    <Button
                        android:id="@+id/btnSendReset"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Send Reset Link ➔"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_gold_text"
                        android:fontFamily="@font/font_display_sora"
                        android:background="@drawable/btn_primary_bg"
                        android:textAllCaps="false"
                        android:layout_marginBottom="10dp" />

                    <!-- Success Confirmation Card (Shown after sending reset email) -->
                    <LinearLayout
                        android:id="@+id/cardSuccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_login_input_field"
                        android:padding="16dp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Reset Link Sent!"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_display_sora"
                            android:textColor="@color/gold_accent"
                            android:layout_marginBottom="5dp" />

                        <TextView
                            android:id="@+id/tvSuccessMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="A password recovery link has been dispatched to your email."
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/login_label_text"
                            android:gravity="center"
                            android:layout_marginBottom="12dp" />

                        <!-- Spam / Junk Warning Notice -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/badge_pill_dark"
                            android:padding="11dp"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚠️ Check your Spam / Junk folder"
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/font_display_sora"
                                android:textColor="@color/gold_accent"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Automated recovery emails from KinTrace may be filtered as Spam or Junk. If found in Junk, tap 'Report not spam' so future emails arrive normally."
                                android:textSize="11sp"
                                android:textColor="@color/login_sub_text"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>

                        <!-- Quick Open Mail Client Button -->
                        <Button
                            android:id="@+id/btnOpenEmailApp"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="✉️  Open Email App"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_display_sora"
                            android:textColor="@color/btn_gold_text"
                            android:background="@drawable/btn_primary_bg"
                            android:textAllCaps="false"
                            android:layout_marginBottom="10dp" />

                        <!-- Resend Link & Cooldown -->
                        <TextView
                            android:id="@+id/btnResend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Didn't receive it? Resend link"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_display_sora"
                            android:textColor="@color/gold_accent"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tvResendCooldown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/login_hint_text"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Remembered Password -> Sign In link inside card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Remembered your password? "
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/login_sub_text" />

                        <TextView
                            android:id="@+id/btnReturnToSignIn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sign In"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_display_sora"
                            android:textColor="@color/gold_accent"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Integrated Medallion Keystone (Locks atop card center with Recovery Key) -->
                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_keystone_medallion"
                    android:elevation="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🔑"
                        android:textSize="20sp" />
                </FrameLayout>

            </FrameLayout>

            <!-- Bottom Flexible Spacer so the lower wooden bough sits cleanly between the Card and Quote Pill -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="52dp" />

            <!-- Bottom High-Contrast Quote Card Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_login_quote_pill"
                android:elevation="2dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="“Every branch stays strong when its roots are protected.”"
                    android:textSize="11.5sp"
                    android:textStyle="bold|italic"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.25"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— KinTrace Lineage Security"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/gold_accent" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
