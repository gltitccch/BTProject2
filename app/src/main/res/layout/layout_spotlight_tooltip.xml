<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardSpotlightTooltip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_kintrace_modal_card"
    android:elevation="16dp"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <!-- Top Header: Breadcrumb Dots & Step Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/layoutSpotlightBreadcrumbs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvSpotlightStepBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tool_dock_tag"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="Step 1 of 3"
            android:textColor="@color/gold_accent"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Minimalist Header Overflow Action Button (Variation A: Micro-Dots ⋮) -->
        <FrameLayout
            android:id="@+id/btnSpotlightOptions"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_spotlight_header_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivSpotlightOptionsIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_more_vert_minimalist"
                android:contentDescription="Guide Options" />
        </FrameLayout>

        <!-- Minimalist Header Close Button -->
        <ImageView
            android:id="@+id/btnSpotlightCloseHeader"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:padding="6dp"
            android:src="@drawable/ic_close_minimalist"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Close Tour" />
    </LinearLayout>

    <!-- Title Row with Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvSpotlightIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_kintrace_modal_crest_gold"
            android:gravity="center"
            android:text="🧭"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSpotlightTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="Feature Title"
            android:textColor="@color/text_primary"
            android:textSize="15.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Description Body -->
    <TextView
        android:id="@+id/tvSpotlightDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:lineSpacingExtra="3dp"
        android:text="Contextual explanation of how this feature works and why it helps your clan."
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <!-- Optional Pro Tip / Mini Context Box -->
    <LinearLayout
        android:id="@+id/layoutSpotlightProTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_tool_dock_tag"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSpotlightProTip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💡 Pro Tip: Tap any relative node to inspect documents."
            android:textColor="@color/gold_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Action Bar: Dismiss | Back | Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSpotlightDismiss"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:text="Dismiss Tour"
            android:textColor="@color/dark_subtext"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSpotlightPrev"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_kintrace_modal_btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Back"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnSpotlightNext"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_kintrace_modal_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Next Step →"
            android:textColor="@color/btn_gold_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
