<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_arcade_dialog"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Header Row: Title & Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮"
            android:textSize="22sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KinClash Live Party"
            android:textSize="17.5sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_display_sora"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/btnModeSelectClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_display_sora"
            android:textColor="#B3A1E6"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose how you want to connect to your clan's live trivia room:"
        android:textSize="12sp"
        android:fontFamily="@font/font_body_inter"
        android:textStyle="bold"
        android:textColor="#B3A1E6"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="16dp" />

    <!-- ── Mission Card 1: Host New Game (3D Purple Arcade Card) ── -->
    <LinearLayout
        android:id="@+id/cardSelectHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_arcade_question_card"
        android:padding="14dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👑"
            android:textSize="28sp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Host New Game"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display_sora"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAME MASTER"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_mono_jetbrains"
                    android:textColor="@color/arcade_yellow"
                    android:background="@drawable/bg_arcade_letter_pill"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generate a Room PIN, customize questions, and run the show on TV/host phone."
                android:textSize="11sp"
                android:fontFamily="@font/font_body_inter"
                android:textColor="#B3A1E6"
                android:lineSpacingExtra="1.5dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Mission Card 2: Enter PIN to Join (3D Golden Arcade Block) ── -->
    <LinearLayout
        android:id="@+id/cardSelectJoin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_arcade_btn_correct"
        android:padding="14dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕹️"
            android:textSize="28sp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter PIN to Join"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display_sora"
                    android:textColor="#000000"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAST PLAY"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_mono_jetbrains"
                    android:textColor="@color/arcade_yellow"
                    android:background="@drawable/bg_arcade_pill_black"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter 4-digit PIN shared by host to play and buzz in on your own device."
                android:textSize="11sp"
                android:fontFamily="@font/font_body_inter"
                android:textStyle="bold"
                android:textColor="#2F2405"
                android:lineSpacingExtra="1.5dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btnModeSelectCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Cancel"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_display_sora"
        android:textColor="#B3A1E6"
        android:background="@drawable/bg_arcade_status_card"
        app:backgroundTint="@null" />

</LinearLayout>
