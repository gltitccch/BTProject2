<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardDeletedMemberRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    android:background="@drawable/bg_admin_code_box"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="11dp"
    android:paddingVertical="9dp">

    <!-- Left Info Column (Compact Direction 3) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDeletedMemberName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/font_display_sora"
                android:maxLines="1"
                android:text="Member Name"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeletedTimeAgo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Just now"
                android:textColor="@color/danger"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDeletedMemberTree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="🌳 Malone Family Tree"
            android:textColor="@color/gold_accent"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Restored Timestamp Row (Shown in Restored History Tab) -->
        <TextView
            android:id="@+id/tvRestoredTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="🕒 Restored: Nov 07, 2026 • 1:45 PM"
            android:textColor="@color/mint_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDeletedMemberDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="ID: member_123 • Deleted by admin"
            android:textColor="@color/text_secondary"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/tvRestorationRequestBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/badge_pill_gold"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="⚡ Requested by Family"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDeletedMemberStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Member record is currently archived."
            android:textColor="@color/danger"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Right Action Column (Side-by-Side Restore + Purge OR Restored Badge) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRestoreMemberItem"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="@color/primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="🩹 Restore"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPurgeMemberItem"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_danger_card_preserved"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🗑️"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvRestoredBadgePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_pill_dark"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="✓ RESTORED"
            android:textColor="@color/mint_text"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
