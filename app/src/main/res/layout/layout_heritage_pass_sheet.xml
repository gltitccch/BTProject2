<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_quick_assist_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Top Drag Handle Bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/badge_pill_dark" />

        <!-- Header Row (Title & Close Button) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="👑"
                android:textSize="22sp"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPassSheetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KinTrace Heritage Pass"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvPassSheetSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="One-Time Lifetime License • ₱99.00 via GCash"
                    android:textSize="12sp"
                    android:textColor="#A3B8AA"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnPassSheetClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="✕"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#C0D4C7"
                android:background="@drawable/badge_pill_dark"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Clan Tree Status & Target Quota Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_quick_assist_card"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌳 "
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvClanName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Family Tree"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvCurrentQuotaPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FREE 50 CAP"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#D4AF37"
                    android:background="@drawable/badge_pill_dark"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTargetCapacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Unlocks 200 Members (+150 Slots Instantly)"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="#4ADE80"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No manual request or admin approval waiting queue required."
                android:textSize="11sp"
                android:textColor="#8EAA97"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Lifetime Pass Perks List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_heritage_pass_gold_card"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HERITAGE PASS PRIVILEGES"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#D4AF37"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <!-- Perk 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_heritage_pass_perk_item"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instant +150 Member Capacity"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expands immediately to 200 members upon GCash authorization."
                        android:textSize="10.5sp"
                        android:textColor="#8EAA97" />
                </LinearLayout>
            </LinearLayout>

            <!-- Perk 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_heritage_pass_perk_item"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="🎙️"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Infinite Oral History Audio Vault"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Record unlimited voice memories &amp; stories for every ancestor."
                        android:textSize="10.5sp"
                        android:textColor="#8EAA97" />
                </LinearLayout>
            </LinearLayout>

            <!-- Perk 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_heritage_pass_perk_item"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="📜"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="300 DPI Heirloom Chart Export"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ultra-sharp printable pedigree charts and family trees."
                        android:textSize="10.5sp"
                        android:textColor="#8EAA97" />
                </LinearLayout>
            </LinearLayout>

            <!-- Perk 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_heritage_pass_perk_item"
                android:padding="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="👑"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIP Clan Crest &amp; Gold Badge"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verified Heritage Pass badge across all tree views &amp; exports."
                        android:textSize="10.5sp"
                        android:textColor="#8EAA97" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Price Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_quick_assist_card"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPriceTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="One-Time Lifetime Fee"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#D4AF37" />

                <TextView
                    android:id="@+id/tvPriceSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Official GCash Checkout • No Subscriptions"
                    android:textSize="10.5sp"
                    android:textColor="#8EAA97"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPriceAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱99.00"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#D4AF37" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════════════
             STATE 1: INITIAL CHECKOUT TRIGGER
             ═══════════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutPassInitial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnPayGcash"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_heritage_pass_btn_gcash"
                android:text="⚡ Pay ₱99.00 with GCash"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnFastSandboxPay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⚡ Fast Sandbox Verification (Capstone Defense Demo)"
                android:textSize="11sp"
                android:textColor="#A3B8AA"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════════════
             STATE 2: LOADING PROGRESS
             ═══════════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutPassLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="#D4AF37" />

            <TextView
                android:id="@+id/tvPassLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connecting to GCash Gateway via Xendit..."
                android:textSize="12.5sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════════════
             STATE 3: WAITING FOR AUTHORIZATION
             ═══════════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutPassWaiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_quick_assist_card"
            android:padding="16dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💳"
                android:textSize="32sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GCash Checkout Opened"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete payment in your browser, then tap below to confirm your automatic +150 member expansion."
                android:textSize="11.5sp"
                android:textColor="#A3B8AA"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvWaitingRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ref: KT-GCASH-xxxx"
                android:textSize="11sp"
                android:textColor="#D4AF37"
                android:background="@drawable/badge_pill_dark"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnCheckPaymentStatus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_heritage_pass_btn_gcash"
                android:text="🔄 Check Payment Status"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnWaitingFastPay"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/badge_pill_mint"
                android:text="⚡ Fast Sandbox Approval (Defense Demo)"
                android:textColor="#16A34A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnReopenCheckout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/badge_pill_dark"
                android:text="🌐 Re-open GCash Page"
                android:textColor="#C0D4C7"
                android:textSize="12.5sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════════════
             STATE 4: PAYMENT SUCCESS & OFFICIAL RECEIPT
             ═══════════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutPassSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_quick_assist_card"
            android:padding="16dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="✓"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:background="@drawable/badge_pill_mint"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment Successful!"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#4ADE80" />

            <TextView
                android:id="@+id/tvSuccessDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tree capacity automatically expanded to 200 members (+150 added)."
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvSuccessRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ref: KT-GCASH-xxxx"
                android:textSize="11sp"
                android:textColor="#D4AF37"
                android:background="@drawable/badge_pill_dark"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnDoneSuccess"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_heritage_pass_btn_gcash"
                android:text="✨ Continue Building Family Tree"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
