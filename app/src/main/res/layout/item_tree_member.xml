<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="23dp"
    android:paddingEnd="20dp"
    android:gravity="center_vertical">

    <!-- Connected Vertical Timeline Spine (Suggestion 1) -->
    <View
        android:id="@+id/viewTimelineSpine"
        android:layout_width="1.5dp"
        android:layout_height="match_parent"
        android:background="@color/forest_card_border"
        android:layout_marginEnd="14dp" />

    <!-- Member Card -->
    <LinearLayout
        android:id="@+id/layoutMemberCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/bg_forest_card"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <!-- Avatar circle -->
        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="RB"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/gold_accent"
            android:background="@drawable/avatar_circle_dark"
            android:layout_marginEnd="12dp" />

        <!-- Name + info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Renzy Bugarin"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Male · b. 2004-03-20 · Living"
                android:textSize="11.5sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Kinship Role Pill (Suggestion 1) -->
        <TextView
            android:id="@+id/tvKinshipPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Founder"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/gold_accent"
            android:background="@drawable/badge_pill_dark"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
