<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base KinTrace Typography Style -->
    <style name="TextAppearance.KinTrace" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/font_body_inter</item>
        <item name="android:fontFamily">@font/font_body_inter</item>
    </style>

    <style name="TextAppearance.KinTrace.Display" parent="TextAppearance.KinTrace">
        <item name="fontFamily">@font/font_display_sora</item>
        <item name="android:fontFamily">@font/font_display_sora</item>
    </style>

    <!-- Display Headings (Sora) -->
    <style name="TextAppearance.KinTrace.Display.Large" parent="TextAppearance.KinTrace.Display">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.KinTrace.Display.Medium" parent="TextAppearance.KinTrace.Display">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.KinTrace.Headline" parent="TextAppearance.KinTrace.Display">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Subtitles & Body (Inter) -->
    <style name="TextAppearance.KinTrace.Subtitle" parent="TextAppearance.KinTrace">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.KinTrace.Body" parent="TextAppearance.KinTrace">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.KinTrace.Body.Secondary" parent="TextAppearance.KinTrace.Body">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.KinTrace.Button" parent="TextAppearance.KinTrace">
        <item name="fontFamily">@font/font_display_sora</item>
        <item name="android:fontFamily">@font/font_display_sora</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- Ahnentafel, Technical Codes & Dates (JetBrains Mono) -->
    <style name="TextAppearance.KinTrace.Monospace" parent="TextAppearance.KinTrace">
        <item name="fontFamily">@font/font_mono_jetbrains</item>
        <item name="android:fontFamily">@font/font_mono_jetbrains</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Badges & Compact Pills (Inter SemiBold) -->
    <style name="TextAppearance.KinTrace.Badge" parent="TextAppearance.KinTrace">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
