<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Gold/Bark Left-Accent Strip (Direction 2 Signature) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/login_input_accent" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <!-- Inner Recessed Input Well -->
    <item android:left="3.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/login_input_bg" />
            <corners
                android:topLeftRadius="10dp"
                android:bottomLeftRadius="10dp"
                android:topRightRadius="13dp"
                android:bottomRightRadius="13dp" />
            <stroke
                android:width="1dp"
                android:color="@color/login_input_border" />
        </shape>
    </item>
</layer-list>
