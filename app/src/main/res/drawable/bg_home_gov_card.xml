<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Left Gold/Bark Accent Bar (Direction 1 Prototype Signature) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/login_input_accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Inner Forest Card Surface -->
    <item android:left="3.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/forest_card" />
            <corners
                android:topLeftRadius="14.5dp"
                android:bottomLeftRadius="14.5dp"
                android:topRightRadius="18dp"
                android:bottomRightRadius="18dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/forest_card_border" />
        </shape>
    </item>
</layer-list>
