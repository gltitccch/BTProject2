<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Bottom Chiseled Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/arcade_btn_shadow" />
        </shape>
    </item>
    <!-- Top Interactive Surface -->
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/arcade_btn_bg" />
            <stroke
                android:width="2dp"
                android:color="@color/arcade_btn_border" />
        </shape>
    </item>
</layer-list>
