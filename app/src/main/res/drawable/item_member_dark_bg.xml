<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1AFFFFFF">
    <item>
        <layer-list>
            <!-- Left Gold/Bark Accent Strip -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/login_input_accent" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Inner Recessed Emerald/Parchment Well -->
            <item android:left="3.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/login_input_bg" />
                    <corners
                        android:topLeftRadius="10.5dp"
                        android:bottomLeftRadius="10.5dp"
                        android:topRightRadius="14dp"
                        android:bottomRightRadius="14dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/login_input_border" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
