<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Bottom Chiseled Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#8C6500" />
        </shape>
    </item>
    <!-- Top Interactive Surface -->
    <item android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:startColor="#FFE600"
                android:endColor="#D4AF37"
                android:angle="270" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
