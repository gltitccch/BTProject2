<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Bottom Chiseled Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#0369A1" />
        </shape>
    </item>
    <!-- Top Interactive Surface -->
    <item android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:startColor="#06B6D4"
                android:endColor="#0284C7"
                android:angle="270" />
            <stroke
                android:width="1.5dp"
                android:color="#67E8F9" />
        </shape>
    </item>
</layer-list>
